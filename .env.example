# Google Gemini API Key (Opsional: jika ingin terisi otomatis saat dev)
# Bisa juga diisi langsung lewat tombol "Gemini API Key" di antarmuka web
VITE_GEMINI_API_KEY=

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# GitHub Repository for Community Stats
VITE_GITHUB_REPO=Daassco/po-translator-ai
